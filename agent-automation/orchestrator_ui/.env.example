# Orchestrator UI — env-only config
# Copy to .env and fill in values.

# Cloud providers (anthropic, openai) are available in llm_provider.py for open-source use
# but are blocked by this app at startup. Only local is supported here.
ORCHESTRATOR_LLM_PROVIDER=local
ORCHESTRATOR_LLM_BASE_URL=http://localhost:11434/v1
ORCHESTRATOR_LLM_MODEL=mistral-nemo

# Optional: OpenAI model when proposer model is claude-* (fallback).
# Must be a valid OpenAI model ID (e.g. gpt-4o, gpt-4o-mini, gpt-4.1-mini), NOT the provider name "anthropic".
# Troubleshooting: "404 model anthropic does not exist" = this was set to a provider name; use a real model ID.
ORCHESTRATOR_OPENAI_MODEL=gpt-4o-mini

# Optional: Workspace root (directory containing PROJECT_WORKSPACE.md).
# Defaults to parent of agent-automation if not set.
# WORKSPACE_PATH=/path/to/workspace
# WORKSPACE_ROOT=/path/to/workspace
