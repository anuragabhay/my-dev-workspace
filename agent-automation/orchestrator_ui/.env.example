# Orchestrator UI — env-only config
# Copy to .env and fill in values.

# LLM provider: openai (default) or anthropic
ORCHESTRATOR_LLM_PROVIDER=openai

# OpenAI (when ORCHESTRATOR_LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
# Optional: OpenAI model when proposer model is claude-* (fallback)
ORCHESTRATOR_OPENAI_MODEL=gpt-4o-mini

# Anthropic (when ORCHESTRATOR_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Workspace root (directory containing PROJECT_WORKSPACE.md).
# Defaults to parent of agent-automation if not set.
# WORKSPACE_PATH=/path/to/workspace
# WORKSPACE_ROOT=/path/to/workspace
