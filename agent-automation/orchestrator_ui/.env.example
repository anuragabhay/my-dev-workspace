# Orchestrator UI — env-only config
# Copy to .env and fill in values.

# Required: Anthropic API key for the brain (propose → critique → synthesize)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Workspace root (directory containing PROJECT_WORKSPACE.md).
# Defaults to parent of agent-automation if not set.
# WORKSPACE_PATH=/path/to/workspace
# WORKSPACE_ROOT=/path/to/workspace
